{
  "name": "@mailermine/node",
  "version": "1.0.0",
  "description": "Official MailerMine SDK for Node.js and TypeScript.",
  "license": "MIT",
  "author": "MailerMine",
  "homepage": "https://mailermine.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailermine/mailermine-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mailermine/mailermine-node-sdk/issues"
  },
  "keywords": [
    "mailermine",
    "email",
    "transactional",
    "sdk",
    "nodejs",
    "typescript",
    "api"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "generate": "node --import tsx scripts/generate.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck:generated",
    "typecheck:generated": "tsc --noEmit --project tsconfig.generated.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release:test": "node scripts/release-test.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "tsx": "4.23.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
